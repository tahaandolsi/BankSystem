{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "security-auth-route": {
        "ClusterId": "security-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "account-api-route": {
        "ClusterId": "account-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        }
      },
      "transaction-api-route": {
        "ClusterId": "transaction-cluster",
        "Match": {
          "Path": "/api/v1/transactions/{**catch-all}"
        }
      },
      "payment-api-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "AuthenticatedUsers",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/transactions/{**catch-all}"
          },
          {
            "RequestHeadersCopy": true
          },
          {
            "ResponseHeadersCopy": true
          }
        ]
      },      "movement-api-route": {
        "ClusterId": "movement-cluster",
        "Match": {
          "Path": "/api/v1/movements/{**catch-all}"
        }
      },
      "notification-api-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "reporting-api-route": {
        "ClusterId": "reporting-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "security-cluster": {
        "Destinations": {
          "security-api": {
            "Address": "http://security:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "account-cluster": {
        "Destinations": {
          "account-api": {
            "Address": "http://account:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-api": {
            "Address": "http://transaction:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "payment-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "payment-api": {
            "Address": "http://host.docker.internal:8081/"
          }
        }
      },      "movement-cluster": {
        "Destinations": {
          "movement-api": {
            "Address": "http://movement:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": {
            "Address": "http://notification:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "reporting-api": {
            "Address": "http://reporting:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  },
  "Gateway": {
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:4200",
        "https://localhost:3000",
        "https://localhost:4200"
      ]
    },
    "RateLimiting": {
      "Global": {
        "PermitLimit": 5000,
        "Window": "00:01:00"
      },
      "PerUser": {
        "PermitLimit": 500,
        "Window": "00:01:00"
      },
      "Api": {
        "PermitLimit": 1000,
        "Window": "00:01:00"
      }
    },
    "Security": {
      "EnableHttpsRedirection": false,
      "RequireHttps": false,
      "EnableHsts": false
    }
  },
  "HealthChecks": {
    "TimeoutSeconds": 15,
    "Self": {
      "Name": "self",
      "Message": "API Gateway is running in Docker"
    },
    "Services": [
      {
        "Name": "security-api",
        "Uri": "http://security:8080/health",
        "DisplayName": "Security API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "security",
          "authentication"
        ]
      },
      {
        "Name": "account-api",
        "Uri": "http://account:8080/health",
        "DisplayName": "Account API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "accounts",
          "core"
        ]
      },
      {
        "Name": "transaction-api",
        "Uri": "http://transaction:8080/health",
        "DisplayName": "Transaction API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "transactions",
          "core"
        ]
      },
      {
        "Name": "movement-api",
        "Uri": "http://movement:8080/health",
        "DisplayName": "Movement API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "movements",
          "read"
        ]
      },
      {
        "Name": "notification-api",
        "Uri": "http://notification:8080/health",
        "DisplayName": "Notification API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "notifications"
        ]
      },
      {
        "Name": "reporting-api",
        "Uri": "http://reporting:8080/health",
        "DisplayName": "Reporting API",
        "TimeoutSeconds": 15,
        "FailureStatus": "Degraded",
        "Tags": [
          "reporting"
        ]
      }
    ]
  },
  "Authentication": {
    "Jwt": {
      "Key": "",
      "Issuer": "BankSystem",
      "Audience": "bank-system-api",
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true
    },
    "RequireHttpsMetadata": false
  }
}
