# Fictitious local examples only. Replace them locally; never commit a real .env file.
BANK_POSTGRES_USER=replace-me
BANK_POSTGRES_PASSWORD=replace-me
BANK_MSSQL_SA_PASSWORD=replace-me-with-a-strong-local-value
BANK_RABBITMQ_USER=replace-me
BANK_RABBITMQ_PASSWORD=replace-me
BANK_JWT_SIGNING_KEY=replace-with-a-generated-local-key
BANK_INTER_SERVICE_API_KEY=replace-with-a-generated-local-key
BANK_SECURITY_DB_CONNECTION=Server=sqlserver,1433;Database=SecurityDb;User Id=sa;Password=replace-me;TrustServerCertificate=True
BANK_ACCOUNT_DB_CONNECTION=Host=postgres;Port=5432;Database=AccountDb;Username=replace-me;Password=replace-me
BANK_TRANSACTION_DB_CONNECTION=Host=postgres;Port=5432;Database=TransactionDb;Username=replace-me;Password=replace-me
BANK_MOVEMENT_DB_CONNECTION=Host=postgres;Port=5432;Database=MovementDb;Username=replace-me;Password=replace-me
BANK_NOTIFICATION_DB_CONNECTION=Host=postgres;Port=5432;Database=NotificationDb;Username=replace-me;Password=replace-me
BANK_REPORTING_DB_CONNECTION=Host=postgres;Port=5432;Database=ReportingDb;Username=replace-me;Password=replace-me